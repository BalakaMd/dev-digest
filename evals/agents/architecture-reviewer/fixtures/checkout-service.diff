+import type { FastifyReply } from 'fastify';
+import { CheckoutRepository } from './repository.js';
+import type { CheckoutOrder } from './types.js';
+
+export class CheckoutService {
+  private readonly repo = new CheckoutRepository();
+
+  async checkout(order: CheckoutOrder, reply?: FastifyReply) {
+    const price = order.total;
+    await this.repo.save(order.id, price);
+    return { price };
+  }
+}
